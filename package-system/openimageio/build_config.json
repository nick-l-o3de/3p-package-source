{
   "git_url":"https://github.com/AcademySoftwareFoundation/OpenImageIO.git",
   "git_tag":"v3.1.15.0",
   "package_name":"OpenImageIO",
   "package_version":"3.1.15.0-rev1",
   "package_url":"https://openimageio.readthedocs.io/en/v3.1.15.0",
   "package_license":"BSD-3-Clause",
   "package_license_file":"LICENSE.md",
   "cmake_find_source":"FindOpenImageIO.cmake",
   "cmake_find_target":"FindOpenImageIO.cmake",
   "extra_files_to_copy": [
      ["temp/src/LICENSE.md", "LICENSE.md"],
      ["temp/working_install/share/doc/OpenImageIO/THIRD-PARTY.md", "THIRD-PARTY.md"],
      ["distribution/README.md", "README.md"]
   ],
   "additional_src_files" : [
      ["FindZLIB.cmake", "zlib-1.2.11-rev5-windows/FindZLIB.cmake"]
   ],
   "cmake_install_filter":[
      "*.a",
      "*.so",
      "*.dylib",
      "bin/OpenImageIO*.dll",
      "bin/iconvert*",
      "bin/idiff*",
      "bin/igrep*",
      "bin/iinfo*",
      "bin/maketx*",
      "bin/oiiotool*",
      "bin/testtex*",
      "*.lib",
      "*.h",
      "*.hpp",
      "*.cpp"
   ],
   "cmake_generate_args_common" : [
      "-DOIIO_BUILD_TESTS=0",
      "-DBUILD_SHARED_LIBS=1",
      "-DLOCAL_BUILD_SHARED_LIBS_DEFAULT=OFF",
      "-DLINKSTATIC=ON",
      "-DOpenImageIO_BUILD_MISSING_DEPS=ALL",
      "-DENABLE_libjpeg-turbo=1",
      "-DENABLE_libjpeg=0",
      "-DENABLE_OpenJPEG=0",
      "-DENABLE_libuhdr=0",
      "-DUSE_QT=0",
      "-DUSE_PYTHON=0"
   ],
   "clean_between_configurations" : true,
