{
   "git_url":"https://github.com/AcademySoftwareFoundation/OpenColorIO.git",
   "git_tag":"v2.4.2",
   "package_name":"OpenColorIO",
   "package_version":"2.4.2-rev1",
   "package_url":"https://opencolorio.org/",
   "package_license":"BSD-3-Clause",
   "package_license_file":"LICENSE",
   "cmake_find_source":"FindOpenColorIO.cmake",
   "cmake_find_target":"FindOpenColorIO.cmake",
   "extra_files_to_copy": [
      ["temp/src/LICENSE", "LICENSE"],
      ["temp/src/THIRD-PARTY.md", "THIRD-PARTY.md"],
      ["distribution/README.md", "README.md"]
   ],
   "additional_src_files" : [
      ["FindZLIB.cmake", "zlib-1.2.11-rev5-windows/FindZLIB.cmake"]
   ],
   "cmake_install_filter":[
      "*.a",
      "*.so",
      "*.dll",
      "bin/ocio*",
      "*.lib",
      "*.h"
   ],
   "cmake_generate_args_common" : [
      "-DOCIO_BUILD_TESTS=0",
      "-DOCIO_BUILD_GPU_TESTS=0",
      "-DOCIO_BUILD_DOCS=0",
      "-DOCIO_BUILD_PYTHON=0",
      "-DOCIO_USE_OIIO_FOR_APPS=ON",
      "-DOCIO_INSTALL_EXT_PACKAGES=MISSING",
      "-DBUILD_SHARED_LIBS=ON",
      "-DLINKSTATIC=ON",
      "-DZLIB_USE_STATIC_LIBS=ON",
      "-Dexpat_STATIC_LIBRARY=ON",
      "-DImath_STATIC_LIBRARY=ON",
      "-Dyaml-cpp_STATIC_LIBRARY=ON",
      "-Dminizip-ng_STATIC_LIBRARY=ON",
      "-DCMAKE_CXX_STANDARD=17",
      "-DCMAKE_DEBUG_POSTFIX=_d"
   ],
   "set_env_vars" : {
      "CMAKE_POLICY_VERSION_MINIMUM" : "3.24"
   },
   "clean_between_configurations" : true,
   "Platforms":{
      "Windows":{
         "Windows":{
            "build_configs" : ["Debug","Release"],
            "depends_on_packages" :[
               ["OpenImageIO-3.1.15.0-rev1-windows", "da6cf692ff6404d2ca81e249b68a2094069ceaece9556fb41bb45dc5b90d0eda", ""],
               ["zlib-1.2.11-rev5-windows", "8847112429744eb11d92c44026fc5fc53caa4a06709382b5f13978f3c26c4cbd", ""]
            ],
            "cmake_generate_args":[
               "-DCMAKE_MSVC_RUNTIME_LIBRARY=\"MultiThreaded$<$<CONFIG:Debug>:Debug>DLL\""
            ],
            "cmake_generate_args_debug":[
               "-DCMAKE_BUILD_TYPE=Debug",
               "-DOCIO_BUILD_APPS=0",
               "-DOpenImageIO_ROOT=../OpenImageIO-3.1.15.0-rev1-windows"
            ],
            "cmake_generate_args_release":[
               "-DCMAKE_BUILD_TYPE=Release",
               "-DOCIO_BUILD_APPS=1",
               "-DOpenImageIO_ROOT=../OpenImageIO-3.1.15.0-rev1-windows"
            ],
            "custom_test_cmd" : [
               "test_opencolorio_windows.cmd"
            ]
         }
      },
      "Darwin":{
         "Mac-arm64":{
            "build_configs" : ["Release"],
            "depends_on_packages" :[
               ["zlib-1.3.1-rev2-mac-arm64", "52e62890329d3e003226fca88df30701cdd862a5f137eb5f75dff504377c13b3", ""]
            ],
            "custom_toolchain_file" : "../cmake/Platform/Mac/Toolchain_mac.cmake",
            "cmake_generate_args_release": [
               "-G",
               "Xcode"
            ],
            "custom_test_cmd" : [
               "test_opencolorio_mac.sh"
            ]
         }
      },
      "Linux":{
         "Linux":{
            "build_configs" : ["release"],
            "depends_on_packages" :[
                ["zlib-1.2.11-rev5-linux", "9be5ea85722fc27a8645a9c8a812669d107c68e6baa2ca0740872eaeb6a8b0fc", ""]
            ],
            "cmake_generate_args_release":[
               "-G",
               "Ninja",
               "-DCMAKE_BUILD_TYPE=Release"
            ]
         },
         "Linux-aarch64":{
            "build_configs" : ["release"],
            "depends_on_packages" :[
                ["zlib-1.2.11-rev5-linux-aarch64", "ce9d1ed2883d77ffc69c7982c078595c1f89ca55ec19d89fe7e6beb05f774775", ""]
            ],
            "cmake_generate_args_release":[
               "-G",
               "Ninja",
               "-DCMAKE_BUILD_TYPE=Release"
            ],
            "custom_test_cmd" : [
               "test_opencolorio_linux.sh"
            ]
         }
      }
   }
}
